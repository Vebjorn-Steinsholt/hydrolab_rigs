<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rig_controller</name>
  <version>0.0.0</version>
  <description>Lifecycle controller for the lab rigs: wavemakers, and the LinMot oscillator.</description>
  <maintainer email="vebjorn.steinsholt@ntnu.no">hydrolab-linux</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>lifecycle_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rig_interfaces</depend>
  <depend>bondcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>mgate5101_driver</depend>
  <depend>linmot_serial_driver</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>rclpy</exec_depend>  <!-- fake_controller test tool, play_dat -->
  <exec_depend>action_msgs</exec_depend>  <!-- play_dat -->
  <exec_depend>python3-gpiozero</exec_depend>  <!-- soft_stop -->
  <exec_depend>python3-lgpio</exec_depend>     <!-- soft_stop, Pi 5 backend -->
  <exec_depend>python3-numpy</exec_depend>       <!-- play_dat, generate_waves -->
  <exec_depend>python3-yaml</exec_depend>        <!-- generate_waves -->
  <exec_depend>python3-matplotlib</exec_depend>  <!-- generate_waves plot -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>