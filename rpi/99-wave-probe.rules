# HC-SR04 wave probe: Arduino Uno R3, USB ID 2341:0043, on the probe Pi (RPi4).
#
# - ModemManager must not probe it: its AT commands and DTR toggling reset the Uno.
# - Matched by serial number, not only by USB ID: the LinMot bridge is an Uno R3 too
#   (99-linmot-bridge.rules), and the two must not take each other's name if they ever end up
#   on one Pi. A replacement board needs its serial here:
#     udevadm info -a -n /dev/ttyACM0 | grep -m1 'ATTRS{serial}'
#
# Install (see ultrasonic_probe_sketch.md, change 3):
#   sudo cp 99-wave-probe.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#   ls -l /dev/wave_probe
ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0043", ATTRS{serial}=="55730303137351D031E2", ENV{ID_MM_DEVICE_IGNORE}="1"
# The symlink only for the serial port, not for the board's USB device node.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0043", ATTRS{serial}=="55730303137351D031E2", SYMLINK+="wave_probe"
